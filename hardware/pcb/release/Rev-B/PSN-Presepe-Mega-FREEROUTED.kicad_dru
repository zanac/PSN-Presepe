(version 1)

# PSN-Presepe internal safety design rule.
# Relay contact nets may carry mains voltage. Keep them separated from SELV/control copper.
# 6 mm is a conservative project design target, not a statement of regulatory certification.
(rule "Relay contacts to SELV 6mm"
  (condition "((A.NetName =~ 'R[0-9]+_(COM|NO|NC)') && !(B.NetName =~ 'R[0-9]+_(COM|NO|NC)')) || ((B.NetName =~ 'R[0-9]+_(COM|NO|NC)') && !(A.NetName =~ 'R[0-9]+_(COM|NO|NC)'))")
  (constraint clearance (min 6mm))
)

# Different relay contact groups: 6 mm internal design target.
# Same-relay COM/NO/NC is excluded because the selected terminal block is 5.08 mm pitch.
(rule "Relay 1 to relay 2 contacts 6mm"
  (condition "((A.NetName =~ 'R1_(COM|NO|NC)') && (B.NetName =~ 'R2_(COM|NO|NC)')) || ((B.NetName =~ 'R1_(COM|NO|NC)') && (A.NetName =~ 'R2_(COM|NO|NC)'))")
  (constraint clearance (min 6mm))
)
(rule "Relay 1 to relay 3 contacts 6mm"
  (condition "((A.NetName =~ 'R1_(COM|NO|NC)') && (B.NetName =~ 'R3_(COM|NO|NC)')) || ((B.NetName =~ 'R1_(COM|NO|NC)') && (A.NetName =~ 'R3_(COM|NO|NC)'))")
  (constraint clearance (min 6mm))
)
(rule "Relay 1 to relay 4 contacts 6mm"
  (condition "((A.NetName =~ 'R1_(COM|NO|NC)') && (B.NetName =~ 'R4_(COM|NO|NC)')) || ((B.NetName =~ 'R1_(COM|NO|NC)') && (A.NetName =~ 'R4_(COM|NO|NC)'))")
  (constraint clearance (min 6mm))
)
(rule "Relay 1 to relay 5 contacts 6mm"
