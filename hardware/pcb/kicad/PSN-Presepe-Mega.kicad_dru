(version 1)

# PSN-Presepe Rev-B safety rules.
# Relay contact nets may carry mains voltage. 6 mm is an internal design target,
# not a statement of regulatory certification.
# KiCad custom-rule string equality supports wildcard matching.

(rule "Relay contacts to SELV 6mm"
  (condition "(((A.NetName == 'R1_*') || (A.NetName == 'R2_*') || (A.NetName == 'R3_*') || (A.NetName == 'R4_*') || (A.NetName == 'R5_*') || (A.NetName == 'R6_*') || (A.NetName == 'R7_*') || (A.NetName == 'R8_*') || (A.NetName == 'R9_*') || (A.NetName == 'R10_*') || (A.NetName == 'R11_*') || (A.NetName == 'R12_*') || (A.NetName == 'R13_*') || (A.NetName == 'R14_*') || (A.NetName == 'R15_*') || (A.NetName == 'R16_*')) && !((B.NetName == 'R1_*') || (B.NetName == 'R2_*') || (B.NetName == 'R3_*') || (B.NetName == 'R4_*') || (B.NetName == 'R5_*') || (B.NetName == 'R6_*') || (B.NetName == 'R7_*') || (B.NetName == 'R8_*') || (B.NetName == 'R9_*') || (B.NetName == 'R10_*') || (B.NetName == 'R11_*') || (B.NetName == 'R12_*') || (B.NetName == 'R13_*') || (B.NetName == 'R14_*') || (B.NetName == 'R15_*') || (B.NetName == 'R16_*'))) || (((B.NetName == 'R1_*') || (B.NetName == 'R2_*') || (B.NetName == 'R3_*') || (B.NetName == 'R4_*') || (B.NetName == 'R5_*') || (B.NetName == 'R6_*') || (B.NetName == 'R7_*') || (B.NetName == 'R8_*') || (B.NetName == 'R9_*') || (B.NetName == 'R10_*') || (B.NetName == 'R11_*') || (B.NetName == 'R12_*') || (B.NetName == 'R13_*') || (B.NetName == 'R14_*') || (B.NetName == 'R15_*') || (B.NetName == 'R16_*')) && !((A.NetName == 'R1_*') || (A.NetName == 'R2_*') || (A.NetName == 'R3_*') || (A.NetName == 'R4_*') || (A.NetName == 'R5_*') || (A.NetName == 'R6_*') || (A.NetName == 'R7_*') || (A.NetName == 'R8_*') || (A.NetName == 'R9_*') || (A.NetName == 'R10_*') || (A.NetName == 'R11_*') || (A.NetName == 'R12_*') || (A.NetName == 'R13_*') || (A.NetName == 'R14_*') || (A.NetName == 'R15_*') || (A.NetName == 'R16_*')))")
  (constraint clearance (min 6mm))
)

# Different relay contact groups: 6 mm. Same-relay COM/NO/NC is intentionally
# excluded because the selected 3-pole terminal pitch is 5.08 mm.
(rule "Relay 1 to relay 2 contacts 6mm"
  (condition "((A.NetName == 'R1_*') && (B.NetName == 'R2_*')) || ((B.NetName == 'R1_*') && (A.NetName == 'R2_*'))")
  (constraint clearance (min 6mm))
)
(rule "Relay 1 to relay 3 contacts 6mm"
  (condition "((A.NetName == 'R1_*') && (B.NetName == 'R3_*')) || ((B.NetName == 'R1_*') && (A.NetName == 'R3_*'))")
